From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex Unleashed <codex-unleashed@users.noreply.github.com>
Date: Sun, 6 Sep 2026 00:00:00 -0400
Subject: [PATCH] Identify Codex Unleashed provider builds

---
 codex-rs/cli/build.rs                    |  5 +++++
 codex-rs/cli/src/main.rs                 | 28 ++++++++++++++++++++++++++++-
 codex-rs/tui/Cargo.toml                  |  1 +
 codex-rs/tui/build.rs                    |  7 +++++++
 codex-rs/tui/src/history_cell/session.rs | 11 ++++++++++-
 codex-rs/tui/src/version.rs              |  8 +++++++-
 5 files changed, 49 insertions(+), 3 deletions(-)

diff --git a/codex-rs/cli/build.rs b/codex-rs/cli/build.rs
index abccc48..b5b80c1 100644
--- a/codex-rs/cli/build.rs
+++ b/codex-rs/cli/build.rs
@@ -1,4 +1,9 @@
 fn main() {
+    let build_number =
+        std::env::var("CODEX_UNLEASHED_BUILD_NUMBER").unwrap_or_else(|_| "dev".to_string());
+    println!("cargo:rustc-env=CODEX_UNLEASHED_BUILD_NUMBER={build_number}");
+    println!("cargo:rerun-if-env-changed=CODEX_UNLEASHED_BUILD_NUMBER");
+
     if std::env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("macos") {
         println!("cargo:rustc-link-arg=-ObjC");
     }
diff --git a/codex-rs/cli/src/main.rs b/codex-rs/cli/src/main.rs
index 71d0323..ff77aee 100644
--- a/codex-rs/cli/src/main.rs
+++ b/codex-rs/cli/src/main.rs
@@ -99,10 +99,27 @@ use codex_terminal_detection::TerminalName;
 /// Codex CLI
 ///
 /// If no subcommand is specified, options will be forwarded to the interactive CLI.
+const CLI_VERSION: &str = concat!(
+    env!("CARGO_PKG_VERSION"),
+    "+",
+    env!("CODEX_UNLEASHED_BUILD_NUMBER"),
+    "\n(See --build-info for more information)"
+);
+
+const BUILD_INFO: &str = concat!(
+    "vendor: codex-unleashed\n",
+    "vendor_url: https://github.com/codex-unleashed/codex-unleashed\n",
+    "upstream_url: https://github.com/openai/codex\n",
+    "upstream_version: ",
+    env!("CARGO_PKG_VERSION"),
+    "\nbuild: ",
+    env!("CODEX_UNLEASHED_BUILD_NUMBER")
+);
+
 #[derive(Debug, Parser)]
 #[clap(
     author,
-    version,
+    version = CLI_VERSION,
     // If a sub‑command is given, ignore requirements of the default args.
     subcommand_negates_reqs = true,
     // The executable is sometimes invoked via a platform‑specific name like
@@ -112,6 +130,10 @@ use codex_terminal_detection::TerminalName;
     override_usage = "codex [OPTIONS] [PROMPT]\n       codex [OPTIONS] <COMMAND> [ARGS]"
 )]
 struct MultitoolCli {
+    /// Print information about the provider build and its upstream source.
+    #[clap(long)]
+    build_info: bool,
+
     #[clap(flatten)]
     pub config_overrides: CliConfigOverrides,
 
@@ -1048,11 +1070,16 @@ async fn cli_main(
 ) -> anyhow::Result<()> {
     let MultitoolCli {
+        build_info,
         config_overrides: mut root_config_overrides,
         feature_toggles,
         remote,
         mut interactive,
         subcommand,
     } = MultitoolCli::parse();
+    if build_info {
+        println!("{BUILD_INFO}");
+        return Ok(());
+    }
     // Fold --enable/--disable into config overrides so they flow to all subcommands.
     let toggle_overrides = feature_toggles.to_overrides()?;
     root_config_overrides.raw_overrides.extend(toggle_overrides);
diff --git a/codex-rs/tui/Cargo.toml b/codex-rs/tui/Cargo.toml
index 7de0ba5..e28e058 100644
--- a/codex-rs/tui/Cargo.toml
+++ b/codex-rs/tui/Cargo.toml
@@ -4,6 +4,7 @@ version.workspace = true
 edition.workspace = true
 license.workspace = true
 autobins = false
+build = "build.rs"
 
 [[bin]]
 name = "codex-tui"
 path = "src/main.rs"
diff --git a/codex-rs/tui/build.rs b/codex-rs/tui/build.rs
new file mode 100644
index 0000000..a2e5b86
--- /dev/null
+++ b/codex-rs/tui/build.rs
@@ -0,0 +1,6 @@
+fn main() {
+    let build_number =
+        std::env::var("CODEX_UNLEASHED_BUILD_NUMBER").unwrap_or_else(|_| "dev".to_string());
+    println!("cargo:rustc-env=CODEX_UNLEASHED_BUILD_NUMBER={build_number}");
+    println!("cargo:rerun-if-env-changed=CODEX_UNLEASHED_BUILD_NUMBER");
+}
diff --git a/codex-rs/tui/src/history_cell/session.rs b/codex-rs/tui/src/history_cell/session.rs
index 03df014..776ba4b 100644
--- a/codex-rs/tui/src/history_cell/session.rs
+++ b/codex-rs/tui/src/history_cell/session.rs
@@ -4,5 +4,6 @@ use super::*;
 use crate::line_truncation::line_width;
 use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
 use crate::width::display_width;
+use crate::version::CODEX_UNLEASHED_URL;
 
 pub(crate) const SESSION_HEADER_MAX_INNER_WIDTH: usize = 56; // Just an eyeballed value
@@ -317,13 +318,19 @@ impl HistoryCell for SessionHeaderHistoryCell {
 
         let make_row = |spans: Vec<Span<'static>>| Line::from(spans);
 
-        // Title line rendered inside the box: ">_ OpenAI Codex (vX)"
+        // Title line rendered inside the box: ">_ OpenAI Codex (vX+build)"
         let title_spans: Vec<Span<'static>> = vec![
             Span::from(">_ ").dim(),
             Span::from("OpenAI Codex").bold(),
             Span::from(" ").dim(),
             Span::from(format!("(v{})", self.version)).dim(),
         ];
+        let provider_url = Line::from(vec![
+            Span::from("   "),
+            Span::from(CODEX_UNLEASHED_URL)
+                .cyan()
+                .underlined(),
+        ]);
 
         const CHANGE_MODEL_HINT_COMMAND: &str = "/model";
         const CHANGE_MODEL_HINT_EXPLANATION: &str = " to change";
@@ -369,6 +376,7 @@ impl HistoryCell for SessionHeaderHistoryCell {
 
         let mut lines = vec![
             make_row(title_spans),
+            provider_url,
             make_row(Vec::new()),
             make_row(model_spans),
             make_row(dir_spans),
@@ -392,6 +400,7 @@ impl HistoryCell for SessionHeaderHistoryCell {
     fn raw_lines(&self) -> Vec<Line<'static>> {
         let mut lines = vec![
             Line::from(format!("OpenAI Codex (v{})", self.version)),
+            Line::from(format!("   {CODEX_UNLEASHED_URL}")),
             Line::from(format!(
                 "model: {}{}",
                 self.model,
 
diff --git a/codex-rs/tui/src/version.rs b/codex-rs/tui/src/version.rs
index 8c8d108..516d07d 100644
--- a/codex-rs/tui/src/version.rs
+++ b/codex-rs/tui/src/version.rs
@@ -1,2 +1,8 @@
 /// The current Codex CLI version as embedded at compile time.
-pub const CODEX_CLI_VERSION: &str = env!("CARGO_PKG_VERSION");
+pub const CODEX_CLI_VERSION: &str = concat!(
+    env!("CARGO_PKG_VERSION"),
+    "+",
+    env!("CODEX_UNLEASHED_BUILD_NUMBER")
+);
+
+pub const CODEX_UNLEASHED_URL: &str = "https://codex-unleashed.com/";
