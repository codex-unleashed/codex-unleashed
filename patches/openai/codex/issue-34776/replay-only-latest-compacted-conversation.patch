From 61a4a716ee63a52a2769d03155a8101ce5b06e9d Mon Sep 17 00:00:00 2001
From: Codex <codex-unleashed@users.noreply.github.com>
Date: Fri, 4 Sep 2026 00:26:42 -0400
Subject: [PATCH 2/2] Replay only the latest compacted conversation


diff --git a/codex-rs/tui/src/chatwidget/replay.rs b/codex-rs/tui/src/chatwidget/replay.rs
index 61d69d1..8ed4df4 100644
--- a/codex-rs/tui/src/chatwidget/replay.rs
+++ b/codex-rs/tui/src/chatwidget/replay.rs
@@ -32,0 +33,13 @@
+        let first_latest_conversation_turn = turns
+            .iter()
+            .rposition(|turn| {
+                turn.items
+                    .iter()
+                    .any(|item| matches!(item, ThreadItem::ContextCompaction { .. }))
+            })
+            .map(|index| index + 1)
+            .unwrap_or(0);
+        let turns = turns
+            .into_iter()
+            .skip(first_latest_conversation_turn)
+            .collect::<Vec<_>>();
-- 
