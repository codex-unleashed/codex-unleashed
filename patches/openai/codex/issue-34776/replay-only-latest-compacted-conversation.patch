Subject: [PATCH 2/2] Replay only the latest compacted conversation


diff --git a/codex-rs/tui/src/chatwidget/replay.rs b/codex-rs/tui/src/chatwidget/replay.rs
index 61d69d1..8ed4df4 100644
--- a/codex-rs/tui/src/chatwidget/replay.rs
+++ b/codex-rs/tui/src/chatwidget/replay.rs
@@ -30,9 +30,22 @@ impl ChatWidget {
     /// avoid triggering side effects. Event ids are passed as `None` to
     /// distinguish replayed events from live ones.
     pub(crate) fn replay_thread_turns(&mut self, turns: Vec<Turn>, replay_kind: ReplayKind) {
         if matches!(replay_kind, ReplayKind::ThreadSnapshot) && !turns.is_empty() {
             self.warning_display_state.startup_complete = true;
         }
+        let first_latest_conversation_turn = turns
+            .iter()
+            .rposition(|turn| {
+                turn.items
+                    .iter()
+                    .any(|item| matches!(item, ThreadItem::ContextCompaction { .. }))
+            })
+            .map(|index| index + 1)
+            .unwrap_or(0);
+        let turns = turns
+            .into_iter()
+            .skip(first_latest_conversation_turn)
+            .collect::<Vec<_>>();
         let latest_turn_id = turns.last().map(|turn| turn.id.clone());
